  "lines": [
    {
      "id": "L1",
      "text": "물류 위탁 계약서",
      "conf": 96.0
    },
    {
      "id": "L2",
      "text": "주식회사 2몰(이하 \"갑\")과 한빚로지스 주식회사(이하 \"을\"\"는 다음과",
      "conf": 88.7
    },
    {
      "id": "L3",
      "text": "같이 계약을 체결한다.",
      "conf": 93.4
    },
    {
      "id": "L4",
      "text": "제1조 (목적) 본 계약은 갑의 상품보관 및 배송 업무를 을에게",
      "conf": 91.5
    },
    {
      "id": "L5",
      "text": "위탁하는 데 필요한사항을 정한다.",
      "conf": 92.1
    },
    {
      "id": "L6",
      "text": "제2조 (계약기간) 본 계약의 기간 은2026년 10월 1일부터",
      "conf": 92.7
    },
    {
      "id": "L7",
      "text": "2027년 9월 30일까지로 한다. 기간만료30일 전까지 서면 통지가",
      "conf": 92.1
    },
    {
      "id": "L8",
      "text": "없으면 동일한 조건으로 1년간 자동 연장된다.",
      "conf": 92.0
    },
    {
      "id": "L9",
      "text": "제3조 (대금지급) 갑은 매월 말일 기준 검수가 완료된 물량에 대하여",
      "conf": 93.8
    },
    {
      "id": "L10",
      "text": "익월 60일 이내에 대금을 지급한다.",
      "conf": 93.0
    },
    {
      "id": "L11",
      "text": "제4조 (손해배상)을의 귀책사유로 갑에게 손해가 발생한경우 을은 이를",
      "conf": 92.4
    },
    {
      "id": "L12",
      "text": "배상한다. 다만배상총액은 직전 3개월 대금합계를 한도로 한다.",
      "conf": 92.2
    },
    {
      "id": "L13",
      "text": "제5조 (계약해지) 각당사자는 30일 전 서면 통지로 본 계약을",
      "conf": 93.3
    },
    {
      "id": "L14",
      "text": "해지할 수 있다.",
      "conf": 94.4
    },
    {
      "id": "L15",
      "text": "제6조 (분쟁해결) 본 계약과 관련한 분쟁은 서울중앙지방법원을 관할",
      "conf": 92.3
    },
    {
      "id": "L16",
      "text": "법원으로 한다.",
      "conf": 91.5
    }
  ]
}